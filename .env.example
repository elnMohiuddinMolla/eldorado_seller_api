# Copy this file to .env and fill in your own values.
# Never commit .env. Never share the Client secret.

# From Eldorado Dashboard > Seller API
ELDORADO_CLIENT_ID=
ELDORADO_CLIENT_SECRET=

# Optional: the credential's expiration date (YYYY-MM-DD).
# The tool warns when 7 days or fewer are left.
ELDORADO_CREDENTIAL_EXPIRES=
